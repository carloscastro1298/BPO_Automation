    {
      "parameters": {
        "jsCode": "\nreturn items.map(item => {\n  const decision = String(item.json.Decision || '').trim();\n  const result = String(item.json.Result || '').trim();\n\n  let decisionType = \"Other\";\n  let riskLevel = \"Low\";\n  let decisionQuality = \"Needs Review\";\n\n  if (decision === \"Listen first\") {\n    decisionType = \"Customer Support\";\n    riskLevel = \"Low\";\n  } else if (decision === \"Inform the customer\") {\n    decisionType = \"Communication\";\n    riskLevel = \"Low\";\n  } else if (decision === \"Check policy\") {\n    decisionType = \"Policy\";\n    riskLevel = \"Medium\";\n  } else if (decision === \"Ask a supervisor\") {\n    decisionType = \"Escalation\";\n    riskLevel = \"High\";\n  } else if (decision === \"Explain the process\") {\n    decisionType = \"Guidance\";\n    riskLevel = \"Low\";\n  } else if (decision === \"Investigate the problem\") {\n    decisionType = \"Investigation\";\n    riskLevel = \"Medium\";\n  }\n\n  if (\n    (riskLevel === \"Low\" && (\n      result === \"Problem solved\" ||\n      result === \"Customer accepted\" ||\n      result === \"Customer understood\"\n    )) ||\n    (riskLevel === \"Medium\" && (\n      result === \"Refund approved\" ||\n      result === \"Problem solved\" ||\n      result === \"Case solved\"\n    )) ||\n    (riskLevel === \"High\" && (\n      result === \"Case solved\" ||\n      result === \"Exception approved\"\n    ))\n  ) {\n    decisionQuality = \"Effective\";\n  }\n\n  // Criticality based on decision risk\n  const criticality =\n    riskLevel === \"High\" ? \"Critical\" : \"Non-Critical\";\n\n  // Read the resolution time directly from Excel\n  const rawTime = item.json.Resolution_Time_Minutes;\n\n  let resolutionTimeMinutes = null;\n\n  if (\n    rawTime !== null &&\n    rawTime !== undefined &&\n    String(rawTime).trim() !== \"\"\n  ) {\n    const parsedTime = Number(rawTime);\n\n    if (Number.isFinite(parsedTime) && parsedTime >= 0) {\n      resolutionTimeMinutes = parsedTime;\n    }\n  }\n\n  // Calculate the TMO category\n  let tmoStatus = \"Not Specified\";\n  let alertRequired = false;\n\n  if (resolutionTimeMinutes !== null) {\n    if (resolutionTimeMinutes <= 5) {\n      tmoStatus = \"Within Target\";\n    } else if (resolutionTimeMinutes <= 30) {\n      tmoStatus = \"Delayed - Within Limit\";\n    } else {\n      tmoStatus = \"Critical\";\n      alertRequired = true;\n    }\n  }\n\n  return {\n    json: {\n      ...item.json,\n      Decision_Type: decisionType,\n      Risk_Level: riskLevel,\n      Decision_Quality: decisionQuality,\n      Criticality: criticality,\n      Resolution_Time_Minutes: resolutionTimeMinutes,\n      TMO_Status: tmoStatus,\n      Alert_Required: alertRequired\n    }\n  };\n});\n"
      },
