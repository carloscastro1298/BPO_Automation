    {
      "parameters": {
        "jsCode": "\nconst cases = $input.all().flatMap(item => {\n  const data = item.json.analisis_completo;\n  return Array.isArray(data) ? data : [item.json];\n});\n\nconst originalItems = $('Code in JavaScript').all();\n\nreturn cases.map(item => {\n  const source = originalItems.find(\n    entry => entry.json.Employee_Name === item.Employee_Name\n  )?.json || {};\n\n  return {\n    json: {\n      Employee_ID: source.Employee_ID || \"\",\n      Employee_Name: item.Employee_Name || source.Employee_Name || \"\",\n      Situation: item.Situation || source.Situation || \"\",\n      Decision: source.Decision || \"\",\n      Reason: source.Reason || \"\",\n      Result: source.Result || \"\",\n      Confidence: source.Confidence || \"\",\n      Decision_Type: source.Decision_Type || \"\",\n      Risk_Level: item.Risk_Level || source.Risk_Level || \"\",\n      Decision_Quality: item.Decision_Quality || source.Decision_Quality || \"\",\n      Criticality: item.Criticality || source.Criticality || \"\",\n      Resolution_Time_Minutes: source.Resolution_Time_Minutes ?? item.Resolution_Time_Minutes ?? \"\",\n      TMO_Status: source.TMO_Status || item.TMO_Status || \"Not Specified\",\n      Alert_Required: source.Alert_Required ?? (item.Alert_Required === true || item.Alert_Required === \"true\"),\n      AI_Analysis: item.AI_Analysis || item.output || \"\"\n    }\n  };\n});\n"
      },
