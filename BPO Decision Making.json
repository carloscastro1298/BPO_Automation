      "parameters": {
        "sendTo": "vanderleyosiriscastrocuadrado@gmail.com",
        "subject": "Critical BPO Cases - Action Required",
        "message": "=\n<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 760px; margin: 0 auto; color: #243247; background-color: #f4f7fb; padding: 24px;\">\n\n  <div style=\"background-color: #172b4d; padding: 28px 24px; border-radius: 12px 12px 0 0; color: #ffffff;\">\n    <p style=\"margin: 0 0 8px; font-size: 12px; letter-spacing: 2px; color: #ffb4a9; font-weight: bold;\">BPO DECISION MAKING</p>\n    <h1 style=\"margin: 0; font-size: 25px; line-height: 1.3;\">Critical Cases Report</h1>\n    <p style=\"margin: 10px 0 0; color: #dbe6f5; font-size: 14px;\">Review required · Automated decision analysis</p>\n  </div>\n\n  <div style=\"background-color: #ffffff; padding: 24px; border: 1px solid #e1e7ef;\">\n    <p style=\"margin-top: 0;\">Hello,</p>\n    <p style=\"line-height: 1.7; color: #526176;\">\n      The following cases require attention. Review the risk, resolution time, and AI recommendations to determine the next action.\n    </p>\n\n    {{ $json.analisis_completo.filter(item => item.Criticality === 'Critical').map((item, index) => {\n      const escapeHtml = (value) => String(value ?? '')\n        .replace(/&/g, '&amp;')\n        .replace(/</g, '&lt;')\n        .replace(/>/g, '&gt;')\n        .replace(/\"/g, '&quot;')\n        .replace(/'/g, '&#39;');\n\n      const analysis = escapeHtml(item.AI_Analysis || item.output || 'No AI analysis available.');\n      const employee = escapeHtml(item.Employee_Name || 'Unknown Employee');\n      const situation = escapeHtml(item.Situation || 'Not specified');\n      const decision = escapeHtml(item.Decision || 'Not specified');\n      const quality = escapeHtml(item.Decision_Quality || 'Not specified');\n      const risk = escapeHtml(item.Risk_Level || 'Not specified');\n      const criticality = escapeHtml(item.Criticality || 'Critical');\n\n      const resolutionTime =\n        item.Resolution_Time_Minutes !== null &&\n        item.Resolution_Time_Minutes !== undefined &&\n        item.Resolution_Time_Minutes !== ''\n          ? `${escapeHtml(item.Resolution_Time_Minutes)} minutes`\n          : 'Not Specified';\n\n      const tmoCategory = escapeHtml(item.TMO_Status || 'Not Specified');\n\n      const alertRequired =\n        item.Alert_Required === true ||\n        String(item.Alert_Required).toLowerCase() === 'true'\n          ? 'Yes'\n          : 'No';\n\n      return `\n        <div style=\"margin: 24px 0; border: 1px solid #dce3ed; border-radius: 10px; overflow: hidden;\">\n\n          <div style=\"background-color: #fff1ef; padding: 16px 18px; border-bottom: 1px solid #f3d4cf;\">\n            <p style=\"margin: 0 0 6px; font-size: 11px; font-weight: bold; color: #a62e25; letter-spacing: 1px;\">CRITICAL CASE ${index + 1}</p>\n            <h2 style=\"margin: 0; font-size: 19px; color: #172b4d;\">${employee}</h2>\n          </div>\n\n          <div style=\"padding: 18px;\">\n            <p style=\"margin: 0 0 16px; color: #526176; line-height: 1.6;\">\n              <strong style=\"color: #243247;\">Situation:</strong><br>${situation}\n            </p>\n\n            <p style=\"margin: 0 0 16px; color: #526176; line-height: 1.6;\">\n              <strong style=\"color: #243247;\">Decision:</strong><br>${decision}\n            </p>\n\n            <table role=\"presentation\" style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n              <tr>\n                <td style=\"padding: 10px; background-color: #f4f7fb; border: 1px solid #e1e7ef; width: 50%;\">\n                  <strong>Criticality</strong><br>\n                  <span style=\"display: inline-block; margin-top: 5px; color: #a62e25; font-weight: bold;\">${criticality}</span>\n                </td>\n                <td style=\"padding: 10px; background-color: #f4f7fb; border: 1px solid #e1e7ef; width: 50%;\">\n                  <strong>Risk Level</strong><br>\n                  <span style=\"display: inline-block; margin-top: 5px;\">${risk}</span>\n                </td>\n              </tr>\n              <tr>\n                <td style=\"padding: 10px; border: 1px solid #e1e7ef;\">\n                  <strong>Decision Quality</strong><br>\n                  <span style=\"display: inline-block; margin-top: 5px;\">${quality}</span>\n                </td>\n                <td style=\"padding: 10px; border: 1px solid #e1e7ef;\">\n                  <strong>Resolution Time</strong><br>\n                  <span style=\"display: inline-block; margin-top: 5px; font-weight: bold;\">Resolution Time: ${resolutionTime}</span>\n                </td>\n              </tr>\n              <tr>\n                <td colspan=\"2\" style=\"padding: 12px; border: 1px solid #e1e7ef;\">\n                  <strong>TMO Category:</strong> ${tmoCategory}<br>\n                  <strong>Alert Required:</strong> ${alertRequired}\n                </td>\n              </tr>\n            </table>\n\n            <div style=\"margin-top: 20px; padding: 16px; background-color: #f4f7fb; border-left: 4px solid #4263a5; border-radius: 4px;\">\n              <h3 style=\"margin: 0 0 10px; font-size: 15px; color: #172b4d;\">AI Analysis &amp; Recommendation</h3>\n              <div style=\"white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.8; color: #526176;\">${analysis}</div>\n            </div>\n          </div>\n        </div>\n      `;\n    }).join('') }}\n\n    <p style=\"margin: 24px 0 0; line-height: 1.7;\">Please review each case and take the necessary action.</p>\n  </div>\n\n  <div style=\"background-color: #e9eef5; padding: 18px 24px; border-radius: 0 0 12px 12px; text-align: center;\">\n    <p style=\"margin: 0; font-size: 12px; color: #526176;\">BPO Decision Making · Automated Report</p>\n    <p style=\"margin: 6px 0 0; font-size: 11px; color: #718096;\">This report was generated automatically.</p>\n  </div>\n\n</div>\n",
